# Copy to .env and fill in values. .env is gitignored; this template is not.

# Backend port (defaults to 3001 if unset)
PORT=3001

# PostgreSQL connection — must match docker-compose.yml credentials.
# Variable names are read by backend/src/app.module.ts via ConfigService.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=escribe
DB_PASSWORD=escribe
DB_NAME=escribe

# OpenRouter API key — get one at https://openrouter.ai/keys
# If unset, AI calls return a fallback stub instead of erroring.
OPENROUTER_API_KEY=
